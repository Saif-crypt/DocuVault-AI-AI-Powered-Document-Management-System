@model DocumentManagementApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<style>
    .auth-page-wrapper {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background-image: url('/images/login-bg.png');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .auth-card {
        background: var(--clr-bg-light);
        border: 1px solid var(--clr-border);
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
    }

    .auth-card-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-card-icon {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, var(--clr-primary), var(--clr-accent));
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: var(--clr-white);
        font-size: 1.8rem;
    }

    .auth-card-header h2 {
        color: var(--clr-text) !important;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .auth-card-header p {
        color: var(--clr-text-muted) !important;
        font-size: 0.95rem;
        margin: 0;
    }

    .auth-form {
        margin-top: 30px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-group label {
        display: block;
        color: var(--clr-text) !important;
        font-weight: 500;
        margin-bottom: 8px;
        font-size: 0.9rem;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--clr-text-muted);
        font-size: 1.1rem;
    }

    .form-group input {
        width: 100%;
        padding: 14px 16px 14px 48px;
        background: var(--clr-bg-dark);
        border: 1px solid var(--clr-border);
        border-radius: 10px;
        color: var(--clr-text) !important;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--clr-primary);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }

    .form-group input::placeholder {
        color: var(--clr-text-muted);
    }

    .check-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 20px 0 30px;
    }

    .check-row input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--clr-primary);
        cursor: pointer;
    }

    .check-row label {
        color: var(--clr-text-muted) !important;
        font-size: 0.9rem;
        cursor: pointer;
        margin: 0;
    }

    .btn-auth-submit {
        width: 100%;
        padding: 15px;
        background: var(--clr-primary);
        color: var(--clr-white) !important;
        border: none;
        border-radius: 10px;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        margin-top: 10px;
    }

    .btn-auth-submit:hover {
        background: var(--clr-primary-light);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(59, 130, 246, 0.3);
    }

    .auth-footer {
        text-align: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid var(--clr-border);
        color: var(--clr-text-muted);
        font-size: 0.9rem;
    }

    .auth-footer a {
        color: var(--clr-primary-light) !important;
        text-decoration: none;
        font-weight: 600;
        margin-left: 5px;
    }

    .auth-footer a:hover {
        text-decoration: underline;
    }

    .validation-summary-errors {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #f87171 !important;
        font-size: 0.9rem;
    }

    .validation-summary-errors ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .text-danger {
        color: #f87171 !important;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }

    /* Dark mode compatibility */
    @@media (prefers-color-scheme: dark) {
        .auth-card {
            background: rgba(30, 41, 59, 0.9);
        }
        
        .form-group input {
            background: rgba(15, 23, 42, 0.8);
        }
    }
</style>

<div class="auth-page-wrapper">
    <div class="auth-card">

        <!-- Header -->
        <div class="auth-card-header">
            <div class="auth-card-icon">
                <i class="bi bi-person-circle"></i>
            </div>
            <h2>Welcome Back</h2>
            <p>Sign in to your DocuVault account</p>
        </div>

        <!-- Form -->
        <form asp-action="Login" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope input-icon"></i>
                    <input asp-for="Email" type="email" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="check-row">
                <input asp-for="RememberMe" type="checkbox" id="RememberMe" />
                <label for="RememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn-auth-submit">Sign In</button>
        </form>

        <!-- Footer -->
        <div class="auth-footer">
            Don't have an account? <a asp-action="Register">Create one</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Focus first input field
        document.querySelector('input[type="email"]')?.focus();
        
        // Form validation enhancement
        const form = document.querySelector('.auth-form');
        form.addEventListener('submit', function(e) {
            const email = document.querySelector('input[type="email"]');
            const password = document.querySelector('input[type="password"]');
            
            if (!email.value.trim()) {
                e.preventDefault();
                email.focus();
                return false;
            }
            
            if (!password.value.trim()) {
                e.preventDefault();
                password.focus();
                return false;
            }
            
            return true;
        });
    </script>
}