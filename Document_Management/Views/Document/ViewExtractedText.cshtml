@model DocumentManagementApp.Models.Document

@{
    ViewData["Title"] = "OCR Extracted Text";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocuVault AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 2rem 0;
        }

        .container-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .text-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #E5E7EB;
        }

        .title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1F2937;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge-ocr {
            background: #3B82F6;
            color: white;
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .info-section {
            background: #F3F4F6;
            padding: 1.5rem;
            border-radius: 12px;
            margin-bottom: 2rem;
        }

        .info-row {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .info-item {
            flex: 1;
            min-width: 200px;
        }

        .info-label {
            font-size: 0.85rem;
            color: #6B7280;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 1rem;
            color: #1F2937;
            font-weight: 600;
        }

        .text-container {
            background: #FAFAFA;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            padding: 2rem;
            max-height: 600px;
            overflow-y: auto;
            font-family: 'Courier New', monospace;
            font-size: 0.95rem;
            line-height: 1.8;
            white-space: pre-wrap;
            word-wrap: break-word;
            color: #1F2937;
        }

        .stats {
            display: flex;
            gap: 1.5rem;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #E5E7EB;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #6B7280;
            font-size: 0.9rem;
        }

        .stat-item i {
            color: #3B82F6;
        }

        .btn-back {
            background: #4F46E5;
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-back:hover {
            background: #4338CA;
            transform: translateY(-2px);
            color: white;
        }
    </style>
</head>
<body>

    <div class="container-main">
        <div class="text-card">
            
            <!-- Header -->
            <div class="header">
                <div class="title">
                    <i class="bi bi-file-earmark-text" style="color: #3B82F6;"></i>
                    OCR Extracted Text
                    <span class="badge-ocr">
                        <i class="bi bi-eye"></i> Raw OCR Output
                    </span>
                </div>
                <a href="/Document" class="btn-back">
                    <i class="bi bi-arrow-left"></i> Back to Documents
                </a>
            </div>

            <!-- Document Info -->
            <div class="info-section">
                <div class="info-row">
                    <div class="info-item">
                        <div class="info-label">File Name</div>
                        <div class="info-value">@Model.FileName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">File Type</div>
                        <div class="info-value">@Model.FileExtension?.ToUpper()</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Uploaded</div>
                        <div class="info-value">@Model.UploadedAt.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">OCR Status</div>
                        <div class="info-value" style="color: #10B981;">✓ Completed</div>
                    </div>
                </div>
            </div>

            <!-- Extracted Text -->
            <div class="text-container">@Model.ExtractedText</div>

            <!-- Statistics -->
            <div class="stats">
                <div class="stat-item">
                    <i class="bi bi-file-text"></i>
                    <span>@(Model.ExtractedText?.Length ?? 0) characters</span>
                </div>
                <div class="stat-item">
                    <i class="bi bi-chat-square-text"></i>
                    <span>@(Model.ExtractedText?.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0) words</span>
                </div>
                <div class="stat-item">
                    <i class="bi bi-list-ol"></i>
                    <span>@(Model.ExtractedText?.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length ?? 0) lines</span>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
