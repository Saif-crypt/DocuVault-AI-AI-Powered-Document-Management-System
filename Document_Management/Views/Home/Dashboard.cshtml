@model DocumentManagementApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --clr-primary: #4F46E5;
        --clr-primary-dark: #4338CA;
        --clr-accent: #06B6D4;
        --clr-bg-dark: #0f172a;
        --clr-bg-light: #1e293b;
        --clr-white: #ffffff;
        --clr-text-muted: #94a3b8;
        --clr-border: #334155;
        --clr-success: #22c55e;
        --clr-warning: #f59e0b;
    }

    body {
        background: linear-gradient(135deg, var(--clr-bg-dark) 0%, #1a1f35 100%);
        min-height: 100vh;
        color: var(--clr-white);
    }

    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .dashboard-header {
        margin-bottom: 3rem;
        text-align: center;
    }

    .dashboard-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--clr-white);
        margin-bottom: 0.5rem;
    }

    .dashboard-header p {
        font-size: 1.1rem;
        color: var(--clr-text-muted);
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .stat-card {
        background: var(--clr-bg-light);
        border: 1px solid var(--clr-border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.3s, box-shadow 0.3s;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--clr-primary), var(--clr-accent));
        opacity: 0;
        transition: opacity 0.3s;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(79, 70, 229, 0.2);
    }

    .stat-card:hover::before {
        opacity: 1;
    }

    .stat-card-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .stat-card-icon.primary {
        background: linear-gradient(135deg, var(--clr-primary), var(--clr-primary-dark));
    }

    .stat-card-icon.accent {
        background: linear-gradient(135deg, var(--clr-accent), #0891b2);
    }

    .stat-card-icon.success {
        background: linear-gradient(135deg, var(--clr-success), #16a34a);
    }

    .stat-card-icon.warning {
        background: linear-gradient(135deg, var(--clr-warning), #d97706);
    }

    .stat-card h3 {
        font-size: 0.9rem;
        color: var(--clr-text-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-card .number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--clr-white);
    }

    /* Quick Actions */
    .quick-actions {
        margin-bottom: 3rem;
    }

    .quick-actions h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--clr-white);
    }

    .action-buttons {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 1rem 1.5rem;
        background: var(--clr-bg-light);
        border: 2px solid var(--clr-border);
        border-radius: 10px;
        color: var(--clr-white);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .action-btn:hover {
        background: var(--clr-primary);
        border-color: var(--clr-primary);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(79, 70, 229, 0.3);
    }

    .action-btn i {
        font-size: 1.5rem;
    }

    /* Recent Documents */
    .recent-documents {
        background: var(--clr-bg-light);
        border: 1px solid var(--clr-border);
        border-radius: 12px;
        padding: 2rem;
    }

    .recent-documents h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--clr-white);
    }

    .document-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .document-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        background: var(--clr-bg-dark);
        border: 1px solid var(--clr-border);
        border-radius: 8px;
        transition: all 0.3s;
    }

    .document-item:hover {
        border-color: var(--clr-primary);
        transform: translateX(5px);
    }

    .document-info {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .document-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, var(--clr-primary), var(--clr-primary-dark));
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .document-details {
        flex: 1;
    }

    .document-details h4 {
        color: var(--clr-white);
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .document-details p {
        color: var(--clr-text-muted);
        font-size: 0.85rem;
    }

    .document-link {
        padding: 0.5rem 1.5rem;
        background: var(--clr-primary);
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s;
    }

    .document-link:hover {
        background: var(--clr-primary-dark);
        transform: scale(1.05);
        color: white;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--clr-text-muted);
    }

    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .empty-state p {
        margin-bottom: 1.5rem;
    }
</style>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <h1>👋 Welcome back, @ViewBag.UserName!</h1>
        <p>Your AI-powered document assistant is ready to help.</p>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-icon primary">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <h3>Total Documents</h3>
            <div class="number">@Model.TotalDocuments</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-icon accent">
                <i class="bi bi-eye"></i>
            </div>
            <h3>OCR Completed</h3>
            <div class="number">@Model.OcrCompleted</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-icon success">
                <i class="bi bi-check-circle"></i>
            </div>
            <h3>NLP Processed</h3>
            <div class="number">@Model.NlpProcessed</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-icon warning">
                <i class="bi bi-lightning"></i>
            </div>
            <h3>Summaries Generated</h3>
            <div class="number">@Model.SummariesGenerated</div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h2>⚡ Quick Actions</h2>
        <div class="action-buttons">
            <a href="/Document/Upload" class="action-btn">
                <i class="bi bi-cloud-upload"></i>
                <span>Upload Document</span>
            </a>
            <a href="/Document/Index" class="action-btn">
                <i class="bi bi-folder2-open"></i>
                <span>My Documents</span>
            </a>
            <a href="/Document/Index#search" class="action-btn">
                <i class="bi bi-search"></i>
                <span>Smart Search</span>
            </a>
        </div>
    </div>

    <!-- Recent Documents -->
    <div class="recent-documents">
        <h2>📄 Recent Documents</h2>
        
        @if (Model.RecentDocuments != null && Model.RecentDocuments.Any())
        {
            <div class="document-list">
                @foreach (var doc in Model.RecentDocuments)
                {
                    <div class="document-item">
                        <div class="document-info">
                            <div class="document-icon">
                                <i class="bi bi-file-earmark"></i>
                            </div>
                            <div class="document-details">
                                <h4>@doc.FileName</h4>
                                <p>Uploaded @doc.UploadedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                            </div>
                        </div>
                        <a href="/Document/Details/@doc.Id" class="document-link">View</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-folder-plus"></i>
                <p>No documents yet. Start by uploading your first document!</p>
                <a href="/Document/Upload" class="action-btn" style="display: inline-flex; margin-top: 1rem;">
                    <i class="bi bi-cloud-upload"></i>
                    <span>Upload Now</span>
                </a>
            </div>
        }
    </div>
</div>
