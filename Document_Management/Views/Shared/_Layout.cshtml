                    <li><a href="/Document/Index" class="nav-link-item"><i class="bi bi-folder2-open"></i> My Documents</a></li>
                    <li><a href="/Document/Upload" class="nav-link-item"><i class="bi bi-cloud-upload"></i> Upload</a></li>
                }
            </ul>

